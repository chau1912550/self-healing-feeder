// Self-healing feeder (FLISR) control panel on a simulated ESP32 in Wokwi.
//
// The study (Python + OpenDSS, scripts/panel_bridge.py) runs on the PC and drives this panel over
// MQTT; the panel sends its button presses back. The frame format is described in shf/panel.py.
// Simulation only: this is not field equipment and it is not connected to a real feeder.
//
// Lamps, in chain order (shf/panel.py LAMPS): Sw1 Sw2 Sw3 Sw4 Sw5 L13 L45 L61 L68 L77 Sw7 Sw9
// Lamp colours: green = closed with power, grey = closed without power, red = open,
// blinking amber = zone the model located, or a tie waiting for CLOSE TIES,
// purple = that switch's sensor sends nothing, blinking red = switch stuck (did not open).
// Failure injection: the SENSOR OFFLINE and SWITCH STUCK slide switches ride along with FAULT.
// Demo mode: if no study answers within 15 s (someone opened a shared link), the board replays
// incidents recorded from the study (the DEMO block below, written by scripts/wokwi_demo.py).

#include <WiFi.h>
#include <PubSubClient.h>
#include <ArduinoJson.h>
#include <Adafruit_NeoPixel.h>
#include <LiquidCrystal_I2C.h>

// On a real board: your own Wi-Fi, and BROKER pointing at the local broker (scada/docker-compose.yml).
#define WIFI_SSID "Wokwi-GUEST"
#define WIFI_PASS ""
#define BROKER "broker.hivemq.com"
#define BROKER_PORT 1883
#define PANEL_ID "shf123-demo"
#define N_LAMPS 12

// BEGIN DEMO (generated by scripts/wokwi_demo.py)
// Recorded study frames, replayed when no study answers (shared link). Do not edit by hand.
const char* DEMO_IDLE = "{\"lamps\":\"GGGGGGGGGGRR\",\"lock\":0,\"wait\":0,\"idle\":1,\"lcd\":[\"SELF-HEALING FEEDER\",\"\",\"FAULT: new fault\",\"simulation only\"],\"rs\":[0.01,1,5,10,25,50,100,200,400]}";
// normal: fault bus 60, 25 ohm; true zone Sw2, ML zone Sw2
const char* DEMO_NORMAL[] = {"{\"lamps\":\"GGGGGGGGGGRR\",\"lock\":0,\"wait\":0,\"idle\":0,\"lcd\":[\"FAULT bus 60 ph 1\",\"line-ground 25 ohm\",\"fault current flows\",\"\"]}", "{\"lamps\":\"RKKKKKKKKKRR\",\"lock\":1,\"wait\":0,\"idle\":0,\"lcd\":[\"Sw1 trips and\",\"LOCKS OUT:\",\"whole feeder dark\",\"\"]}", "{\"lamps\":\"RAKKKKKKKKRR\",\"lock\":1,\"wait\":0,\"idle\":0,\"lcd\":[\"ML locates zone Sw2\",\"confidence 99%\",\"from the switch\",\"readings\"]}", "{\"lamps\":\"RRKRKKKRKKRR\",\"lock\":1,\"wait\":0,\"idle\":0,\"lcd\":[\"Isolate Sw2:\",\"open L61 Sw2 Sw4\",\"\",\"\"]}", "{\"lamps\":\"GRGRKGGRKKRR\",\"lock\":0,\"wait\":0,\"idle\":0,\"lcd\":[\"Re-close Sw1:\",\"power back to L13\",\"L45 Sw1 Sw3\",\"\"]}", "{\"lamps\":\"GRGRKGGRKKAR\",\"lock\":0,\"wait\":1,\"idle\":0,\"lcd\":[\"Tie ready: Sw7\",\"picks up 440 kW\",\"press CLOSE TIES\",\"\"]}"};
const char* DEMO_NORMAL_TIES[] = {"{\"lamps\":\"GRGRGGGRGKGR\",\"lock\":0,\"wait\":0,\"idle\":0,\"lcd\":[\"Closed Sw7\",\"+440 kW restored\",\"Dark until repair:\",\"L61 L77 Sw4\"]}"};
const int DEMO_NORMAL_N = 6, DEMO_NORMAL_TIES_N = 1;
// sensor: fault bus 60, 25 ohm; true zone Sw2, ML zone Sw2
const char* DEMO_SENSOR[] = {"{\"lamps\":\"GGGGPGGGGGRR\",\"lock\":0,\"wait\":0,\"idle\":0,\"lcd\":[\"FAULT bus 60 ph 1\",\"line-ground 25 ohm\",\"fault current flows\",\"\"]}", "{\"lamps\":\"RKKKPKKKKKRR\",\"lock\":1,\"wait\":0,\"idle\":0,\"lcd\":[\"Sw1 trips and\",\"LOCKS OUT:\",\"whole feeder dark\",\"\"]}", "{\"lamps\":\"RKKKPKKKKKRR\",\"lock\":1,\"wait\":0,\"idle\":0,\"lcd\":[\"Sensor Sw5 offline:\",\"model uses other 9.\",\"Study, Sw5 missing:\",\"88% of faults right\"]}", "{\"lamps\":\"RAKKPKKKKKRR\",\"lock\":1,\"wait\":0,\"idle\":0,\"lcd\":[\"ML locates zone Sw2\",\"confidence 99%\",\"from the switch\",\"readings\"]}", "{\"lamps\":\"RRKRKKKRKKRR\",\"lock\":1,\"wait\":0,\"idle\":0,\"lcd\":[\"Isolate Sw2:\",\"open L61 Sw2 Sw4\",\"\",\"\"]}", "{\"lamps\":\"GRGRKGGRKKRR\",\"lock\":0,\"wait\":0,\"idle\":0,\"lcd\":[\"Re-close Sw1:\",\"power back to L13\",\"L45 Sw1 Sw3\",\"\"]}", "{\"lamps\":\"GRGRKGGRKKAR\",\"lock\":0,\"wait\":1,\"idle\":0,\"lcd\":[\"Tie ready: Sw7\",\"picks up 440 kW\",\"press CLOSE TIES\",\"\"]}"};
const char* DEMO_SENSOR_TIES[] = {"{\"lamps\":\"GRGRGGGRGKGR\",\"lock\":0,\"wait\":0,\"idle\":0,\"lcd\":[\"Closed Sw7\",\"+440 kW restored\",\"Dark until repair:\",\"L61 L77 Sw4\"]}"};
const int DEMO_SENSOR_N = 7, DEMO_SENSOR_TIES_N = 1;
// stuck: fault bus 35, 25 ohm; true zone Sw3, ML zone Sw3
const char* DEMO_STUCK[] = {"{\"lamps\":\"GGGGGGGGGGRR\",\"lock\":0,\"wait\":0,\"idle\":0,\"lcd\":[\"FAULT bus 35 ph 1\",\"line-ground 25 ohm\",\"fault current flows\",\"\"]}", "{\"lamps\":\"RKKKKKKKKKRR\",\"lock\":1,\"wait\":0,\"idle\":0,\"lcd\":[\"Sw1 trips and\",\"LOCKS OUT:\",\"whole feeder dark\",\"\"]}", "{\"lamps\":\"RKAKKKKKKKRR\",\"lock\":1,\"wait\":0,\"idle\":0,\"lcd\":[\"ML locates zone Sw3\",\"confidence 100%\",\"from the switch\",\"readings\"]}", "{\"lamps\":\"RKSKKKKKKKRR\",\"lock\":1,\"wait\":0,\"idle\":0,\"lcd\":[\"Open Sw3: STUCK,\",\"it did not open.\",\"Back-up: isolate\",\"the next zone too\"]}", "{\"lamps\":\"RKSKKRRKKKRR\",\"lock\":1,\"wait\":0,\"idle\":0,\"lcd\":[\"Isolate L13+Sw3:\",\"open L13 L45\",\"\",\"\"]}", "{\"lamps\":\"GGSGGRRGGGRR\",\"lock\":0,\"wait\":0,\"idle\":0,\"lcd\":[\"Re-close Sw1:\",\"power back to L61\",\"L68 L77 Sw1 Sw2 Sw4\",\"Sw5\"]}", "{\"lamps\":\"GGSGGRRGGGAR\",\"lock\":0,\"wait\":1,\"idle\":0,\"lcd\":[\"Tie ready: Sw7\",\"picks up 515 kW\",\"press CLOSE TIES\",\"\"]}"};
const char* DEMO_STUCK_TIES[] = {"{\"lamps\":\"GGSGGRRGGGGR\",\"lock\":0,\"wait\":0,\"idle\":0,\"lcd\":[\"Closed Sw7\",\"+515 kW restored\",\"Dark until repair:\",\"none\"]}"};
const int DEMO_STUCK_N = 7, DEMO_STUCK_TIES_N = 1;
// END DEMO

const int PIN_LAMPS = 13, PIN_LOCK = 4, PIN_KNOB = 34;
const int PIN_SENSOR = 32, PIN_STUCK = 33;            // slide switches, ON = pulled to GND
const int PIN_BTN[3] = {25, 26, 27};                  // FAULT, CLOSE TIES, RESET
const char* BTN_CMD[3] = {"fault", "ties", "reset"};
const char* TOPIC_STATE = "shf/" PANEL_ID "/state";
const char* TOPIC_CMD = "shf/" PANEL_ID "/cmd";

Adafruit_NeoPixel lamps(N_LAMPS, PIN_LAMPS, NEO_GRB + NEO_KHZ800);
LiquidCrystal_I2C lcd(0x27, 20, 4);
WiFiClient net;
PubSubClient mqtt(net);

char lampCode[N_LAMPS + 1] = "GGGGGGGGGGRR";
bool lockout = false, idle = false, waiting = false;
double rs[16];
int nRs = 0, knobIdx = -1;
bool btnLast[3] = {true, true, true};
unsigned long btnTime[3] = {0, 0, 0}, lastDraw = 0;
bool demo = false, gotFrame = false;                 // demo: replay recorded frames, no study
unsigned long waitStart = 0, nextAt = 0;
const char** playList = nullptr;
int playN = 0, playIdx = 0;
const char** tiesList = nullptr;
int tiesN = 0;

void lcdLine(int row, const char* text) {
  char buf[21];
  snprintf(buf, sizeof buf, "%-20.20s", text);
  lcd.setCursor(0, row);
  lcd.print(buf);
}

uint32_t colour(char c, bool on) {
  switch (c) {
    case 'G': return lamps.Color(0, 170, 0);
    case 'R': return lamps.Color(200, 0, 0);
    case 'K': return lamps.Color(35, 35, 35);
    case 'A': return on ? lamps.Color(240, 140, 0) : 0;
    case 'P': return lamps.Color(130, 0, 170);
    case 'S': return on ? lamps.Color(255, 0, 0) : lamps.Color(40, 0, 0);
    default:  return 0;
  }
}

void drawLamps() {
  bool on = (millis() / 350) % 2 == 0;
  for (int i = 0; i < N_LAMPS; i++) lamps.setPixelColor(i, colour(lampCode[i], on));
  lamps.show();
  digitalWrite(PIN_LOCK, lockout ? HIGH : LOW);
}

bool sensorOff() { return digitalRead(PIN_SENSOR) == LOW; }
bool stuckOn() { return digitalRead(PIN_STUCK) == LOW; }

// On an idle frame, LCD line 2 shows the knob's fault resistance and line 3 the failures armed.
int failShown = -1;
void drawKnob() {
  if (!idle || nRs == 0) return;
  int idx = min(nRs - 1, (int)((long)analogRead(PIN_KNOB) * nRs / 4096));
  int fail = (sensorOff() ? 1 : 0) + (stuckOn() ? 2 : 0);
  if (idx == knobIdx && fail == failShown) return;
  knobIdx = idx;
  failShown = fail;
  char buf[24];
  snprintf(buf, sizeof buf, "Knob: R = %g ohm", rs[idx]);
  lcdLine(1, demo ? "Demo: 25 ohm runs" : buf);
  if (demo) lcdLine(3, "recorded from study");
  const char* armed[4] = {"FAULT: new fault", "FAULT +no sensor", "FAULT +stuck switch", "FAULT +sensor +stuck"};
  lcdLine(2, armed[fail]);
}

void onMessage(char* topic, byte* payload, unsigned int len) {
  gotFrame = true;
  JsonDocument doc;
  if (deserializeJson(doc, payload, len)) return;
  const char* code = doc["lamps"] | "";
  if (strlen(code) == N_LAMPS) memcpy(lampCode, code, N_LAMPS);
  lockout = (doc["lock"] | 0) == 1;
  waiting = (doc["wait"] | 0) == 1;
  idle = (doc["idle"] | 0) == 1;
  JsonArray r = doc["rs"];
  if (!r.isNull()) {
    nRs = 0;
    for (JsonVariant v : r) if (nRs < 16) rs[nRs++] = v.as<double>();
  }
  JsonArray lines = doc["lcd"];
  for (int i = 0; i < 4; i++) lcdLine(i, lines[i] | "");
  knobIdx = -1;
  failShown = -1;
  drawKnob();
  drawLamps();
}

void show(const char* frame) { onMessage(nullptr, (byte*)frame, strlen(frame)); }

void play(const char** list, int n) { playList = list; playN = n; playIdx = 0; nextAt = millis(); }

// Demo mode: the buttons replay recorded frames instead of asking the study.
void demoButton(int b) {
  if (b == 0 && idle) {
    if (stuckOn()) { play(DEMO_STUCK, DEMO_STUCK_N); tiesList = DEMO_STUCK_TIES; tiesN = DEMO_STUCK_TIES_N; }
    else if (sensorOff()) { play(DEMO_SENSOR, DEMO_SENSOR_N); tiesList = DEMO_SENSOR_TIES; tiesN = DEMO_SENSOR_TIES_N; }
    else { play(DEMO_NORMAL, DEMO_NORMAL_N); tiesList = DEMO_NORMAL_TIES; tiesN = DEMO_NORMAL_TIES_N; }
  } else if (b == 1 && waiting && tiesN > 0) {
    play(tiesList, tiesN);
    tiesN = 0;
  } else if (b == 2) {
    playN = 0;
    show(DEMO_IDLE);
  }
}

void enterDemo() {
  demo = true;
  Serial.println("no study answered: demo mode (recorded frames)");
  show(DEMO_IDLE);
}

void send(int b) {
  if (demo) { demoButton(b); return; }
  JsonDocument doc;
  doc["cmd"] = BTN_CMD[b];
  if (b == 0) {                        // FAULT: only when the study is ready for a new one
    if (!idle || knobIdx < 0) return;
    doc["r"] = rs[knobIdx];
    doc["sensor"] = sensorOff() ? 1 : 0;
    doc["stuck"] = stuckOn() ? 1 : 0;
  }
  if (b == 1 && !waiting) return;      // CLOSE TIES: only when a tie is waiting
  char buf[96];
  serializeJson(doc, buf);
  mqtt.publish(TOPIC_CMD, buf);
  Serial.printf("sent %s\n", buf);
}

void connect() {
  if (WiFi.status() != WL_CONNECTED) {
    lcdLine(0, "Connecting Wi-Fi...");
    WiFi.begin(WIFI_SSID, WIFI_PASS, 6);   // channel 6 = Wokwi's access point; drop it on a real board
    for (int i = 0; i < 75 && WiFi.status() != WL_CONNECTED; i++) delay(200);
    if (WiFi.status() != WL_CONNECTED) { enterDemo(); return; }
  }
  lcdLine(0, "Connecting MQTT...");
  char id[32];
  snprintf(id, sizeof id, "shf-panel-%08lx", (unsigned long)esp_random());
  for (int i = 0; i < 5 && !mqtt.connect(id); i++) delay(1000);
  if (!mqtt.connected()) { enterDemo(); return; }
  mqtt.subscribe(TOPIC_STATE);
  mqtt.publish(TOPIC_CMD, "{\"cmd\":\"hello\"}");
  lcdLine(0, "Waiting for study:");
  lcdLine(1, "run panel_bridge.py");
  lcdLine(2, "(else demo in 15 s)");
  if (!waitStart) waitStart = millis();
}

void setup() {
  Serial.begin(115200);
  for (int b = 0; b < 3; b++) pinMode(PIN_BTN[b], INPUT_PULLUP);
  pinMode(PIN_SENSOR, INPUT_PULLUP);
  pinMode(PIN_STUCK, INPUT_PULLUP);
  pinMode(PIN_LOCK, OUTPUT);
  lamps.begin();
  lamps.setBrightness(120);
  lcd.init();
  lcd.backlight();
  lcdLine(0, "SELF-HEALING FEEDER");
  lcdLine(3, "simulation only");
  mqtt.setServer(BROKER, BROKER_PORT);
  mqtt.setBufferSize(1024);
  mqtt.setKeepAlive(60);   // the simulator can run at a third of real time; 15 s pings then arrive too late
  mqtt.setCallback(onMessage);
  drawLamps();
}

void loop() {
  if (!demo) {
    if (!mqtt.connected()) connect();
    if (!demo) mqtt.loop();
    if (!demo && !gotFrame && waitStart && millis() - waitStart > 15000) enterDemo();
  }
  if (playIdx < playN && millis() >= nextAt) {   // demo playback, one frame every 1.5 s
    show(playList[playIdx++]);
    nextAt = millis() + 1500;
  }
  for (int b = 0; b < 3; b++) {          // buttons pull the pin low; 40 ms debounce
    bool now = digitalRead(PIN_BTN[b]);
    if (now != btnLast[b] && millis() - btnTime[b] > 40) {
      btnTime[b] = millis();
      btnLast[b] = now;
      if (!now) send(b);
    }
  }
  if (millis() - lastDraw > 100) {
    lastDraw = millis();
    drawKnob();
    drawLamps();
  }
}
