# Python environment and caches (recreate with: pip install -r requirements.txt)
.venv/
__pycache__/
*.pyc
.pytest_cache/

# Large or regenerable outputs (run.py recreates them)
data/generated/
# Third-party data downloaded by hand (e.g. PJM hourly load from Kaggle)
data/external/
# Trained model: regenerate with run.py; pickle files should not be shared/loaded from others
models/

# Kaggle upload bundle (built locally, contains third-party wheels)
dist/

# Personal resume notes (kept on this machine only)
docs/RESUME_BULLETS.md

# Local editor/preview settings (the shared agent commands are kept)
.claude/*
!.claude/commands/

# API keys (template: .env.example; registry: config/apis.md)
.env

# Source documents that must stay on this machine
inputs/private/

# AutoCAD backup, lock and plot-log files (cad/ keeps only .dxf and .dwg)
*.bak
*.dwl
*.dwl2
plot.log

# LTspice run files (spice/ keeps the .asc schematics and the .pwl input)
spice/*.raw
spice/*.log
spice/*.net
spice/*.op.raw

spice/*.db

# AutoCAD core console crash-reporter logs
ErrorReports/
